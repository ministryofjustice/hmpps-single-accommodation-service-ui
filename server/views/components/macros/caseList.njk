{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% extends "partials/layout.njk" %}

{% set pageTitle = "Case list" %}
{% set mainClasses = "govuk-body" %}
{% set caseListV2 = featureFlags.caseListV2 or caseListV2Tabs %}
{% set caseListV2Tabs = featureFlags.caseListV2Tabs %}

{% macro caseList(caseListSettings) %}
  <div class="govuk-tabs">
    <ul class="govuk-tabs__list">
      {% for tab in caseListSettings.tabs %}
        <li class="govuk-tabs__list-item {% if tab.selected %}govuk-tabs__list-item--selected{% endif %}">
          <a class="govuk-tabs__tab" href="{{ tab.href }}">{{ tab.text }}</a>
        </li>
      {% endfor %}
    </ul>
    <div class="govuk-tabs__panel">
      <h2 class="govuk-heading-l">
        {{ 'Housing support needed' if caseListSettings.peopleType === 'NFA_RISK' else 'Settled housing secured' }}
      </h2>
      <form method="get" class="sas-filters govuk-!-margin-bottom-8">
        <input type="hidden" name="peopleType" value="{{ caseListSettings.peopleType }}" />
        <div class="govuk-grid-row">
          <div class="govuk-grid-column-one-half">
            {{
              govukInput({
                label: { text: 'Filter by name, CRN or prison number' },
                name: 'searchTerm',
                value: caseListSettings.query.searchTerm
              })
            }}
          </div>
        </div>
        <div class="govuk-grid-row">
{% if 'assignedTo' not in caseListSettings.disabledFields %}
          <div class="govuk-grid-column-one-quarter">
            {{
              govukSelect({
                label: {
                  text: 'Assigned to'
                },
                name: 'teamCode',
                value: caseListSettings.query.teamCode,
                items: caseListSettings.assignedToOptions
              })
            }}
          </div>
                {% endif %}

          <div class="govuk-grid-column-one-quarter">
            {{
              govukSelect({
                label: {
                  text: 'RoSH'
                },
                name: 'riskLevel',
                value: caseListSettings.query.riskLevel,
                items: caseListSettings.riskLevelOptions
              })
            }}
          </div>
        </div>
        <div class="govuk-grid-row">
          <div class="govuk-grid-column-full">
            <div class="sas-filters__actions">{{ govukButton({ text: 'Apply filters' }) }}</div>
          </div>
        </div>
      </form>

      {% if caseListSettings.filters and caseListSettings.filters.length %}
        <div class="sas-filters__summary">
          <h2 id="case-list-summary" class="govuk-heading-m">Showing {{ caseListSettings.resultsSummary }}</h2>
          <p class="govuk-!-margin-bottom-1">Filters applied:</p>
          <ul class="moj-filter-tags">
            {% for filter in caseListSettings.filters %}
              <li>
                <a class="moj-filter__tag" href="{{ filter.href }}"
                  ><span class="govuk-visually-hidden">Remove this filter</span> {{ filter.text }}</a
                >
              </li>
            {% endfor %}
          </ul>
          <p class="govuk-!-margin-bottom-1">
            <a class="govuk-link govuk-link--no-visited-state" href="?peopleType={{ caseListSettings.peopleType }}">Clear filters</a>
          </p>
        </div>
      {% else %}
        <h2 id="case-list-summary" class="govuk-heading-m">{{ caseListSettings.resultsSummary }}</h2>
      {% endif %}

      {{
        govukTable({
          classes: 'sas-table',
          attributes: {
            'aria-labelledby': 'case-list-summary'
          },
          head: caseListSettings.casesTableColumns,
          rows: caseListSettings.casesRows
        })
      }}
    </div>
  </div>
{% endmacro %}
