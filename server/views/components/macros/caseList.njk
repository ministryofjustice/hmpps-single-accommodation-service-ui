{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% macro caseList(caseListSettings) %}
  <div class="govuk-tabs">
    <ul class="govuk-tabs__list">
      {% for tab in caseListSettings.tabs %}
        <li class="govuk-tabs__list-item {% if tab.selected %}govuk-tabs__list-item--selected{% endif %}">
          <a class="govuk-tabs__tab" href="{{ tab.href }}">{{ tab.text }}</a>
        </li>
      {% endfor %}
    </ul>
    <div class="govuk-tabs__panel">
      <h2 class="govuk-heading-l">
        {{ 'Housing support needed' if caseListSettings.peopleType === 'NFA_RISK' else 'Settled housing secured' }}
      </h2>
      <form method="get" class="sas-filters govuk-!-margin-bottom-8">
        <input type="hidden" name="peopleType" value="{{ caseListSettings.peopleType }}" />
        <div class="govuk-grid-row">
          <div class="govuk-grid-column-one-half">
            {{
              govukInput({
                label: { text: 'Filter by name, CRN or prison number' },
                name: 'searchTerm',
                value: caseListSettings.query.searchTerm
              })
            }}
          </div>
        </div>
        <div class="govuk-grid-row">
          {% if caseListSettings.assignedToOptions %}
            <div class="govuk-grid-column-one-quarter">
              <div class="govuk-form-group">
                <label class="govuk-label" for="assignedTo">Assigned to</label>
                <select class="govuk-select" id="assignedTo" name="assignedTo">
                  <option
                    value="{{ caseListSettings.assignedToOptions.user.value }}"
                    {% if caseListSettings.assignedToOptions.user.selected %}selected{% endif %}
                  >
                    {{ caseListSettings.assignedToOptions.user.text }}
                  </option>
                  {% if caseListSettings.assignedToOptions.teams %}
                    <optgroup label="Teams">
                      {% for team in caseListSettings.assignedToOptions.teams %}
                        <option value="team_{{ team.value }}" {% if team.selected %}selected{% endif %}>
                          {{ team.text }}
                        </option>
                      {% endfor %}
                    </optgroup>
                  {% endif %}
                  {% if caseListSettings.assignedToOptions.teamMembers %}
                    <optgroup label="Team members">
                      {% for teamMember in caseListSettings.assignedToOptions.teamMembers %}
                        <option value="member_{{ teamMember.value }}" {% if teamMember.selected %}selected{% endif %}>
                          {{ teamMember.text }}
                        </option>
                      {% endfor %}
                    </optgroup>
                  {% endif %}
                </select>
              </div>
            </div>
          {% endif %}

          <div class="govuk-grid-column-one-quarter">
            {{
              govukSelect({
                label: {
                  text: 'RoSH'
                },
                name: 'riskLevel',
                value: caseListSettings.query.riskLevel,
                items: caseListSettings.riskLevelOptions
              })
            }}
          </div>
        </div>
        <div class="govuk-grid-row">
          <div class="govuk-grid-column-full">
            <div class="sas-filters__actions">{{ govukButton({ text: 'Apply filters' }) }}</div>
          </div>
        </div>
      </form>

      {% if caseListSettings.filters and caseListSettings.filters.length %}
        <div class="sas-filters__summary">
          <h2 id="case-list-summary" class="govuk-heading-m">Showing {{ caseListSettings.resultsSummary }}</h2>
          <p class="govuk-!-margin-bottom-1">Filters applied:</p>
          <ul class="moj-filter-tags">
            {% for filter in caseListSettings.filters %}
              <li>
                <a class="moj-filter__tag" href="{{ filter.href }}"
                  ><span class="govuk-visually-hidden">Remove this filter</span> {{ filter.text }}</a
                >
              </li>
            {% endfor %}
          </ul>
          <p class="govuk-!-margin-bottom-1">
            <a class="govuk-link govuk-link--no-visited-state" href="?peopleType={{ caseListSettings.peopleType }}"
              >Clear filters</a
            >
          </p>
        </div>
      {% else %}
        <h2 id="case-list-summary" class="govuk-heading-m">{{ caseListSettings.resultsSummary }}</h2>
      {% endif %}

      {{
        govukTable({
          classes: 'sas-table',
          attributes: {
            'aria-labelledby': 'case-list-summary'
          },
          head: caseListSettings.casesTableColumns,
          rows: caseListSettings.casesRows
        })
      }}
    </div>
  </div>
{% endmacro %}
