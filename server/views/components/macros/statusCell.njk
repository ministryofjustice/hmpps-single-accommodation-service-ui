{%- from "components/macros/statusTag.njk" import statusTag %}

{%- macro statusCell(context) -%}
<div>
  <span class="sas-table__cell-header" aria-hidden="true">Status and details</span>
</div>
<div>
  <span class="govuk-table-span govuk-!-display-block govuk-!-margin-bottom-2">
    {{ statusTag(context.status) }}
  </span>
  {%- if context.dateText %}
    <span class="govuk-table-span">
    <span class="govuk-hint">{{ context.dateText }}</span>
    {%- if context.dateDescription %}
      <br />
      <span class="govuk-hint">{{ context.dateDescription }}</span>
    {%- endif %}
  </span>
  {%- endif %}
  {%- if context.details %}
    {% for detail in context.details %}
      {% if detail.html %}
        {{ detail.html | safe }}
      {% else %}
        <p class="govuk-!-margin-bottom-1">{{ detail.text }}</p>
      {% endif %}
    {% endfor %}
  {%- endif %}
</div>
{%- endmacro -%}
