{% extends "pages/proposed-address/layout.njk" %}

{% from "govuk/components/radios/macro.njk" import govukRadios %}

{% set pageTitle = "Select an address" %}
{% set backLinkHref = paths.proposedAddresses.lookup({crn: crn}) %}
{% set formAction = paths.proposedAddresses.selectAddress({crn: crn}) %}
{% set hideManualAddressEntry = featureFlags.hideManualAddressEntry %}

{% block extraAction %}
  {% if not hideManualAddressEntry %}
    <p>
      <a class="govuk-link govuk-link--no-visited-state" href="{{ paths.proposedAddresses.details({ crn: crn }) }}">
        Enter address manually
      </a>
    </p>
  {% endif %}
{% endblock %}

{% if hideManualAddressEntry %}
  {% set addressHint = undefined %}
{% else %}
  {% set addressHint = { text: "If your address is not listed, select 'Enter address manually'." } %}
{% endif %}

{% block formContent %}
  <legend class="govuk-fieldset__legend govuk-fieldset__legend--l govuk-!-margin-bottom-0">
    <h1 class="govuk-fieldset__heading">{{ addresses | length }} addresses found</h1>
  </legend>

  <div class="govuk-inset-text govuk-inset-text--previous-answers">
    <dl>
      {% if not exactMatch %}
        <p class="govuk-body govuk-!-margin-bottom-2">No exact matches.</p>
        <p class="govuk-body govuk-!-margin-bottom-2">Showing results for:</p>
      {% endif %}
      <dt>UK postcode</dt>
      <dd>{{ postcode }}</dd>
      {% if nameOrNumber and exactMatch %}
        <dt>Property name or number</dt>
        <dd>{{ nameOrNumber }}</dd>
      {% endif %}
    </dl>

    <a class="govuk-link govuk-link--no-visited-state" href="{{ paths.proposedAddresses.lookup({crn: crn}) }}">Change</a>
  </div>

  {{
    govukRadios({
      name: "addressUprn",
      fieldset: {
        legend: {
          text: "Select an address",
          classes: "govuk-fieldset__legend--m"
        }
      },
      hint: addressHint,
      items: addresses,
      errorMessage: errors.addressUprn
    })
  }}
{% endblock %}
